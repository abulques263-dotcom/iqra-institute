# Required server-only key for the AI Study Assistant and AI question generator.
# Create a key in Google AI Studio. Do not prefix it with VITE_ and never commit it.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional public application URL.
APP_URL="MY_APP_URL"

# SMTP Email Configuration (Optional - for direct email delivery to parents)
# If not provided, the applet operates in test sandbox mode with instant email preview & logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IQRA INSTITUTE <abulques263@gmail.com>"

